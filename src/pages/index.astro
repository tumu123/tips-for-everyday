---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, CATEGORIES, AD_SLOTS } from '../utils/site-config';
import { getAllArticles, getArticleUrl } from '../utils/articles';

const allArticles = await getAllArticles();
const featured = allArticles.slice(0, 6);

// 各栏目文章数量
const categoryCounts = Object.fromEntries(
  Object.entries(CATEGORIES).map(([slug, cat]) => [
    slug,
    allArticles.filter((a) => a.data.category === cat.title).length,
  ])
);

// 各栏目取前 3 篇用于首页展示
const categoryPreview = Object.entries(CATEGORIES)
  .map(([slug, cat]) => ({
    slug,
    ...cat,
    count: categoryCounts[slug],
    articles: allArticles.filter((a) => a.data.category === cat.title).slice(0, 3),
  }))
  .filter((c) => c.articles.length > 0);
---

<BaseLayout
  title={SITE.title}
  description={SITE.description}
  keywords={[
    'everyday tips',
    'home hacks',
    'cleaning tips',
    'save money at home',
    'household tips',
  ]}
>
  <section class="hero">
    <div class="container">
      <h1>Practical answers to everyday problems at home</h1>
      <p>
        Step-by-step guides with specific ratios, dwell times, and the mistakes that
        waste your time. Cleaning, organizing, fixing, and cutting household costs —
        written to be followed, not skimmed.
      </p>
    </div>
  </section>

  <div class="container">
    {/*
      首页唯一广告位：放在第一个内容区块之上，不打断卡片流。

      这里按 AdSense 后台给出的标准写法直接内联（ins + 紧随其后的 push），
      不走 AdSlot 组件，方便逐字对照后台代码排查问题。

      只省略 adsbygoogle.js 那一行：BaseLayout 已在 <head> 注入同一 URL、
      同一个 client，这里重复写只会二次加载同一个脚本。

      与 BaseLayout 的统一 push 不冲突：这段是同步执行的，会先给 ins 打上
      data-adsbygoogle-status，等 DOMContentLoaded 时统一脚本检测到该属性就跳过。
      赋值写成 window.adsbygoogle（而不是裸的 adsbygoogle）是为了在任何脚本
      模式下都不会抛 ReferenceError，效果与后台代码一致。
    */}
    <div class="ad-slot ad-slot--auto" data-ad-slot={AD_SLOTS.categoryTop}>
      <span class="ad-slot__label">Advertisement</span>
      <!-- Horizontal Banner -->
      <ins
        class="adsbygoogle"
        style="display:block"
        data-ad-client={SITE.adsenseClient}
        data-ad-slot={AD_SLOTS.categoryTop}
        data-ad-format="auto"
        data-full-width-responsive="true"></ins>
      <script is:inline>
        (window.adsbygoogle = window.adsbygoogle || []).push({});
      </script>
    </div>

    {
      featured.length > 0 && (
        <>
          <h2 class="section-title">Latest Guides</h2>
          <div class="card-grid">
            {featured.map((article) => (
              <article class="card">
                <a
                  class="card__category"
                  href={`/${Object.entries(CATEGORIES).find(([, c]) => c.title === article.data.category)?.[0]}/`}
                >
                  {article.data.category}
                </a>
                <h3 class="card__title">
                  <a href={getArticleUrl(article)}>{article.data.title}</a>
                </h3>
                <p class="card__desc">{article.data.description}</p>
              </article>
            ))}
          </div>
        </>
      )
    }

    {
      categoryPreview.map((cat) => (
        <>
          <h2 class="section-title">
            <a href={`/${cat.slug}/`} style="text-decoration:none;color:inherit;">
              {cat.title}
            </a>
            <span
              style="font-size:0.6em;font-weight:400;color:var(--color-text-muted);margin-left:0.5em;"
            >
              {cat.count} guides
            </span>
          </h2>
          <div class="card-grid">
            {cat.articles.map((article) => (
              <article class="card">
                <h3 class="card__title">
                  <a href={getArticleUrl(article)}>{article.data.title}</a>
                </h3>
                <p class="card__desc">{article.data.description}</p>
              </article>
            ))}
          </div>
          <p style="font-size:var(--text-sm);">
            <a href={`/${cat.slug}/`}>View all {cat.title} guides →</a>
          </p>
        </>
      ))
    }

    {
      allArticles.length === 0 && (
        <p style="padding:var(--space-7) 0;color:var(--color-text-muted);">
          Content is being published. Check back soon.
        </p>
      )
    }
  </div>
</BaseLayout>
