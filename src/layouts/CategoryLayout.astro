---
/**
 * 栏目布局
 * 用于栏目首页与子栏目页
 */
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import AdSlot from '../components/AdSlot.astro';
import { SITE, AD_SLOTS, subcategoryToSlug, SUBCATEGORY_DESCRIPTIONS } from '../utils/site-config';
import { getArticleUrl, type Article } from '../utils/articles';

interface Props {
  categorySlug: string;
  category: { title: string; description: string; subcategories: string[] };
  allArticles: Article[];
  activeSubcategory?: string;
}

const { categorySlug, category, allArticles, activeSubcategory } = Astro.props;

// 筛选本栏目文章
const catArticles = allArticles.filter((a) => a.data.category === category.title);

// 子栏目筛选
const visible = activeSubcategory
  ? catArticles.filter(
      (a) =>
        a.data.subcategory &&
        subcategoryToSlug(a.data.subcategory) === activeSubcategory
    )
  : catArticles;

const activeSubName = activeSubcategory
  ? category.subcategories.find((s) => subcategoryToSlug(s) === activeSubcategory)
  : undefined;

const crumbs = [
  { label: 'Home', href: '/' },
  ...(activeSubName
    ? [
        { label: category.title, href: `/${categorySlug}/` },
        { label: activeSubName },
      ]
    : [{ label: category.title }]),
];

const pageTitle = activeSubName
  ? `${activeSubName} — ${category.title}`
  : category.title;

// 子栏目优先使用专属描述，回退到栏目描述。
// 同名子栏目可被 "categorySlug/SubName" 复合键覆盖（如 Organize 与 Home Hacks 都有 Laundry）。
const subOverride = activeSubName
  ? SUBCATEGORY_DESCRIPTIONS[`${categorySlug}/${activeSubName}`]
  : undefined;
const pageDescription = activeSubName
  ? subOverride ?? SUBCATEGORY_DESCRIPTIONS[activeSubName] ?? category.description
  : category.description;

// 子栏目页的 meta description 带文章数；栏目页保持简洁
const metaDescription = activeSubName
  ? pageDescription
  : `${category.description} Browse ${visible.length} practical guides.`;

// 子栏目页的 H1 与页头文案使用专属描述
const headerDescription = activeSubName ? pageDescription : category.description;
---

<BaseLayout
  title={pageTitle}
  description={metaDescription}
  keywords={[category.title.toLowerCase(), ...category.subcategories.map((s) => s.toLowerCase())]}
>
  <div class="container">
    <Breadcrumb items={crumbs} />

    <header class="category-header">
      <h1>{activeSubName ?? category.title}</h1>
      <p>{headerDescription}</p>
    </header>

    {
      !activeSubName && (
        <div class="card-grid">
          {category.subcategories.map((sub) => {
            const count = catArticles.filter(
              (a) => a.data.subcategory && subcategoryToSlug(a.data.subcategory) === subcategoryToSlug(sub)
            ).length;
            return (
              <article class="card">
                <a
                  class="card__category"
                  href={`/${categorySlug}/${subcategoryToSlug(sub)}/`}
                >
                  Subcategory
                </a>
                <h3 class="card__title">
                  <a href={`/${categorySlug}/${subcategoryToSlug(sub)}/`}>{sub}</a>
                </h3>
                <p class="card__desc">{count} guide{count === 1 ? '' : 's'}</p>
              </article>
            );
          })}
        </div>
      )
    }

    <AdSlot slot={AD_SLOTS.categoryTop} format="horizontal" />

    {/*
      列表第 5 条之后插一个广告位。拆成两个 grid 而不是把广告塞进 grid 里：
      广告作为 grid 子项会占一格，把卡片排布挤出空洞；拆开后两段各自成行。
    */}
    <div class="card-grid">
      {
        visible.slice(0, 5).map((article) => (
          <article class="card">
            {article.data.subcategory && (
              <a
                class="card__category"
                href={`/${categorySlug}/${subcategoryToSlug(article.data.subcategory)}/`}
              >
                {article.data.subcategory}
              </a>
            )}
            <h3 class="card__title">
              <a href={getArticleUrl(article)}>{article.data.title}</a>
            </h3>
            <p class="card__desc">{article.data.description}</p>
          </article>
        ))
      }
    </div>

    {visible.length > 5 && <AdSlot slot={AD_SLOTS.categoryTop} format="horizontal" />}

    <div class="card-grid">
      {
        visible.slice(5).map((article) => (
          <article class="card">
            {article.data.subcategory && (
              <a
                class="card__category"
                href={`/${categorySlug}/${subcategoryToSlug(article.data.subcategory)}/`}
              >
                {article.data.subcategory}
              </a>
            )}
            <h3 class="card__title">
              <a href={getArticleUrl(article)}>{article.data.title}</a>
            </h3>
            <p class="card__desc">{article.data.description}</p>
          </article>
        ))
      }
    </div>

    {
      visible.length === 0 && (
        <p style="padding:var(--space-6) 0;color:var(--color-text-muted);">
          No guides published in this section yet.
        </p>
      )
    }
  </div>
</BaseLayout>
