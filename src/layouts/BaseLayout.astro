---
/**
 * 全站基础布局
 * 负责：<head> 元信息、AdSense 脚本、GA4、页头页脚
 */
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../utils/site-config';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** 完整规范 URL，留空则由 Astro 自动生成 */
  canonical?: string;
  /** 是否输出 noindex */
  noindex?: boolean;
  keywords?: string[];
  type?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
}

const {
  title,
  description,
  canonical,
  noindex = false,
  keywords = [],
  type = 'website',
  publishedTime,
  modifiedTime,
} = Astro.props;

const pageTitle = title === SITE.title ? title : `${title} | ${SITE.title}`;
const canonicalURL = canonical ?? new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/images/og-default.jpg', Astro.site).href;

const adsenseConfigured = SITE.adsenseClient && !SITE.adsenseClient.includes('XXXX');
const ga4Configured =
  SITE.ga4MeasurementId && !SITE.ga4MeasurementId.includes('XXXX');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {!noindex && <meta name="robots" content="index, follow, max-image-preview:large" />}

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:image" content={ogImage} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Site-level structured data -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Organization',
        name: SITE.title,
        url: SITE.url,
        description: SITE.description,
      })}
    />

    <!-- Site verification (fill in the value from Search Console after launch) -->
    <!-- <meta name="google-site-verification" content="..." /> -->

    {
      adsenseConfigured && (
        <>
          <script
            is:inline
            async
            src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${SITE.adsenseClient}`}
            crossorigin="anonymous"
          />
          {/*
            每页只 push 一次：遍历页面上所有广告单元，逐个入队。
            原先每个 AdSlot 各带一段 push，页内单元变多后容易出现漏 push
            或重复 push；集中到一处后，增删广告位不用再动组件。
          */}
          <script is:inline>
            (function () {
              function fill() {
                var units = document.querySelectorAll('ins.adsbygoogle');
                for (var i = 0; i < units.length; i++) {
                  if (units[i].getAttribute('data-adsbygoogle-status')) continue;
                  (window.adsbygoogle = window.adsbygoogle || []).push({});
                }
              }
              if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', fill);
              } else {
                fill();
              }
            })();
          </script>
        </>
      )
    }

    {
      ga4Configured && (
        <>
          <script
            is:inline
            async
            src={`https://www.googletagmanager.com/gtag/js?id=${SITE.ga4MeasurementId}`}
          />
          <script
            is:inline
            set:html={`window.dataLayer = window.dataLayer || [];
function gtag(){dataLayer.push(arguments);}
gtag('js', new Date());
gtag('config', '${SITE.ga4MeasurementId}');`}
          />
        </>
      )
    }
  </head>

  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
